# ========================================================
# Proton Power Infra — Environment Configuration Template
# ========================================================
# All variables in Vite must start with VITE_ to be exposed to the client.
# Copy this file to .env.local to test locally:
#   cp .env.example .env.local
#
# NOTE: Do NOT commit .env or .env.local to git (already added to .gitignore)

# Site URL (for SEO OpenGraph canonical links)
VITE_SITE_URL=https://protonpowerinfra.com

# Optional: Form submission API (Web3Forms or Formspree)
# If left blank, all enquiry forms will smoothly trigger direct WhatsApp / mailto channels
VITE_WEB3FORMS_ACCESS_KEY=
VITE_FORMSPREE_KEY=

# Optional: Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=
